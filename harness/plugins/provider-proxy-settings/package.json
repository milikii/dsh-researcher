{
  "name": "@dsh-local/provider-proxy-settings",
  "version": "0.1.0",
  "private": true,
  "description": "Provider proxy: route selected model providers through an HTTP proxy (llm/stream waterfall + curl). Settings card in Settings → Plugins (可配置), hot-reloadable, survives restarts.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "MIT"
}