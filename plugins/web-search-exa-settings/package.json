{
  "name": "@dsh-local/web-search-exa-settings",
  "version": "0.1.0",
  "private": true,
  "description": "Official Exa web search provider + GUI settings card (Settings → Plugins → web-search-exa), hot-reloadable.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-web-search-exa": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}